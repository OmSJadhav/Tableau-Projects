      <aliases enabled='yes' />
      <column caption='Index_Customer' datatype='integer' name='[Calculation_1473406288875520]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='INDEX()'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='Rank_Regions' datatype='integer' name='[Calculation_1473406290153474]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='RANK(sum([Sales]),&apos;desc&apos;)'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='Running_Sum' datatype='real' name='[Calculation_1473406291902467]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='RUNNING_SUM(SUM([Sales]))'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='Window_Sum' datatype='real' name='[Calculation_1473406292660229]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='WINDOW_SUM(sum([Sales]),-2,0)'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='String_fun_left()' datatype='string' name='[Calculation_1473406294024198]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='LEFT([Sub-Category],4)' />
      </column>
      <column caption='Profit_tag' datatype='string' name='[Calculation_1473406294962183]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='if [Profit] &gt;5000 then &quot;Highly&#13;&#10;Profitable&quot;&#13;&#10;ELSEIF [Profit] &lt;= 0 then &quot; Non&#13;&#10;Profitable&quot;&#13;&#10;else &quot;Profitable&quot;&#13;&#10;END' />
      </column>
      <column caption='StatewiseProfit' datatype='real' name='[Calculation_1473406298562570]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='if [State]== [Parameters].[Parameter 1473406298173449] then&#13;&#10;[Profit]&#13;&#10;END' />
      </column>
